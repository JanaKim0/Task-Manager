{
  "name": "task-manager-desktop",
  "productName": "Task Manager",
  "version": "1.2.0",
  "description": "Task Manager — a personal task board",
  "author": "Jana Kim",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:parts": "npm run build --prefix ../backend && npm run build:desktop --prefix ../frontend",
    "stage": "node scripts/stage.js",
    "pack": "npm run build:parts && npm run stage && electron-builder --dir",
    "dist": "npm run build:parts && npm run stage && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "dev.janakim.taskmanager",
    "productName": "Task Manager",
    "copyright": "Copyright (c) 2026 Jana Kim",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "lib/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app-content",
        "to": "app-content"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Task Manager",
      "deleteAppDataOnUninstall": false
    }
  }
}
